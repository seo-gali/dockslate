{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DockSlate",
    "category": "DeveloperTool",
    "shortDescription": "Docker Engine, Compose and container management for Windows",
    "useLocalToolsDir": true,
    "resources": {
      "target/release/docker.exe": "bin/docker.exe",
      "target/windows-docker/docker.exe": "libexec/docker.exe",
      "target/windows-docker/cli-plugins/docker-compose.exe": "libexec/cli-plugins/docker-compose.exe",
      "target/windows-docker/cli-plugins/docker-buildx.exe": "libexec/cli-plugins/docker-buildx.exe",
      "target/windows-docker/licenses/": "libexec/licenses/",
      "target/windows-docker/manifest.json": "libexec/manifest.json",
      "target/installer-resources/guide.html": "guide.html",
      "../docs/REQUEST_STATUS.md": "docs/REQUEST_STATUS.md",
      "../docs/results/refinement-verification.md": "docs/results/refinement-verification.md",
      "../docs/results/release-0.1.5.md": "docs/results/release-0.1.5.md",
      "../docs/results/table-layout.json": "docs/results/table-layout.json",
      "../docs/results/node-example.json": "docs/results/node-example.json",
      "../docs/results/cleanup-feedback.md": "docs/results/cleanup-feedback.md",
      "../docs/results/cleanup-feedback-verification.json": "docs/results/cleanup-feedback-verification.json",
      "../docs/results/cve-2026-98432-wsl.md": "docs/results/cve-2026-98432-wsl.md",
      "../docs/results/ui-workflow-0.1.4.json": "docs/results/ui-workflow-0.1.4.json",
      "../USER_GUIDE.md": "USER_GUIDE.md",
      "../examples/": "examples/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "DockSlate",
        "installerHooks": "installer/hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}
